<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/main.uss?fileID=7433441132597879392&amp;guid=8951db20a14ff40e892103983ef380b5&amp;type=3#main"/>
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/gameplay.uss?fileID=7433441132597879392&amp;guid=a335810bcc80449f3be75a58e1332016&amp;type=3#gameplay"/>
    <ui:VisualElement name="gameplay-container">
        <ui:VisualElement name="game-container">
            <ui:Label text="This is your clue." name="clue-label">
                <Bindings>
                    <ui:DataBinding property="style.display" data-source-path="showClues" data-source-type="Unity.Samples.LetterSpell.PlayerSettingsDataSource, Assembly-CSharp" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="success-image">
                <ui:Image source="project://database/Assets/Resources/Images/Success-Check.png?fileID=-9040358768007008051&amp;guid=cba63604506fe4fcfa0f3523cfb6c5fd&amp;type=3#Success-Check_0" name="success-icon"/>
                <ui:Label text="Correct" name="success-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="letter-card-container"/>
        </ui:VisualElement>
        <ui:VisualElement name="buttons-container">
            <ui:VisualElement name="left-buttons-container">
                <ui:Button text="I I" name="pause-button" class="letter-spell-button letter-spell-button-secondary"/>
                <ui:Button text="Options " name="options-button" class="letter-spell-button letter-spell-button-secondary"/>
            </ui:VisualElement>
            <ui:Button text="Next Word" name="next-button" class="letter-spell-button letter-spell-button-primary"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="pause-screen" class="pause-screen">
        <ui:VisualElement name="" class="pause-screen-dialog">
            <ui:VisualElement name="" class="pause-screen-label-container">
                <ui:Label text="Game paused" name="pause-label" class="pause-screen-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="" class="pause-screen-buttons-container">
                <ui:Button text="End game" name="submit-button" class="letter-spell-button letter-spell-button-secondary pause-screen-button-left"/>
                <ui:Button text="Resume" name="dismiss-button" class="letter-spell-button letter-spell-button-primary"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="results-screen" class="pause-screen">
        <ui:VisualElement name="" class="pause-screen-dialog">
            <ui:VisualElement name="" class="pause-screen-label-container">
                <ui:Label text="Game over" name="results-label" class="pause-screen-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="" class="pause-screen-buttons-container">
                <ui:Button text="Main menu" name="submit-button" class="letter-spell-button letter-spell-button-secondary pause-screen-button-left"/>
                <ui:Button text="Play again" name="dismiss-button" class="letter-spell-button letter-spell-button-primary"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
